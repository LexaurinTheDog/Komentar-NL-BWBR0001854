  "historical12k": {
    "version": "2008-01-01",
    "raw_path": "sources/review-batch09-sv-historical.xml",
    "raw_sha256": "481a61d333ac6df668b3048d7653835ef7c883888571aa6880b794f335685719",
    "text": "1 Bij toepassing van artikel 74 van het Wetboek van Strafrecht dan wel van het bepaalde krachtens artikel 74c van dat wetboek moet het beklag worden gedaan binnen drie maanden na de datum waarop de rechtstreeks belanghebbende met deze toepassing bekend is geworden.\n\n2 Het beklag kan ook na deze termijn worden gedaan, indien de verdachte niet aan de gestelde voorwaarden voldoet."
  },
