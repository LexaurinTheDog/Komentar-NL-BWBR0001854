  <meta-data><jcis><jci versie="1.3" verwijzing="jci1.3:c:BWBR0019836&amp;hoofdstuk=III&amp;artikel=6&amp;lid=1&amp;z=2022-11-25&amp;g=2022-11-25" onderdeel="lid=1"/></jcis></meta-data></lid>
